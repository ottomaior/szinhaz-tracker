# Public client config (safe to expose in the built app — Supabase Row
# Level Security is what actually protects the data, not this key).
# Copy this file to .env and fill in the values from your Supabase
# project's Settings -> API page.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only secret used by sync/run.ts (the recurring listings sync job).
# NEVER prefix this with EXPO_PUBLIC_ and never commit it — it bypasses
# Row Level Security. In GitHub Actions this is set as a repo secret
# (SUPABASE_SERVICE_ROLE_KEY), not read from this file.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Cloudflare Web Analytics site token for web.vastaps.app, rendered into the
# beacon tag by app/+html.tsx. Public by nature (it ships in the HTML), but
# leave it empty locally: with no token the export carries no beacon, and only
# the Railway production service should set it. Create the site at
# https://dash.cloudflare.com -> Analytics & Logs -> Web Analytics, hostname
# web.vastaps.app, and copy the token out of the snippet it shows.
EXPO_PUBLIC_CF_BEACON_TOKEN=

# Cloudflare Pages, for deploying landing/ with `npm run deploy:landing`.
# Create the token at https://dash.cloudflare.com/profile/api-tokens with the
# "Cloudflare Pages: Edit" permission; the account ID is on the dashboard
# overview. Neither belongs in the app bundle, so no EXPO_PUBLIC_ prefix.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Azure AI Speech, for the promo narration (scripts/render-tour.ts). Create a
# Speech resource at https://portal.azure.com — the free F0 tier covers 500k
# characters a month and the whole script is under two thousand — then copy a
# key and the region from its "Keys and Endpoint" page. Server-side only, so
# no EXPO_PUBLIC_ prefix.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# ElevenLabs, for the promo narration (scripts/render-tour.ts). Sign in at
# https://elevenlabs.io, then Developers -> API Keys -> Create Key. Free-plan
# output is non-commercial and needs attribution, so anything published has to
# be generated on a paid plan. Server-side only: no EXPO_PUBLIC_ prefix.
ELEVENLABS_API_KEY=

# Supabase personal access token, for the settings the app cannot reach from
# code: the auth redirect allow list, email confirmation, SMTP. Those live in
# project config rather than in the database, so the service role key above
# does not open them and no migration can set them. Create one at
# https://supabase.com/dashboard/account/tokens. It is scoped to your whole
# Supabase account, not to this project, so treat it as the most dangerous
# value in this file: .env only, never a repo secret, revoke it if it leaks.
# Read by the Supabase CLI (`npx supabase`) and by the Management API.
SUPABASE_ACCESS_TOKEN=

# Resend — the transactional mail provider behind Supabase Auth (ISSUES.md
# T-005). Full-access key, used to manage the sending domain from scripts;
# the key Supabase itself sends with is a separate sending-only one that
# lives in the project's SMTP settings, not here.
RESEND_API_KEY=

# Web Push (T-089) has no key in this file on purpose. The public half of the
# VAPID pair is in app.config.ts (extra.vapidPublicKey), because it is public;
# the private half is a Supabase Edge Function secret (VAPID_PRIVATE_KEY, with
# VAPID_PUBLIC_KEY and VAPID_SUBJECT beside it) and must never be committed.

# The weekly letter (T-090) sends through Resend from an Edge Function, so the
# key it uses is the function secret RESEND_API_KEY (the same value as the
# RESEND_API_KEY above, stored a second time on the Supabase side), with
# DIGEST_FROM beside it. The sync only decides *when*: Mondays in Budapest, or
# any run with SYNC_FORCE_DIGEST=1 for a rehearsal.
