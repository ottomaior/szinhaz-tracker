# Public client config (safe to expose in the built app — Supabase Row
# Level Security is what actually protects the data, not this key).
# Copy this file to .env and fill in the values from your Supabase
# project's Settings -> API page.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only secret used by sync/run.ts (the recurring listings sync job).
# NEVER prefix this with EXPO_PUBLIC_ and never commit it — it bypasses
# Row Level Security. In GitHub Actions this is set as a repo secret
# (SUPABASE_SERVICE_ROLE_KEY), not read from this file.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
