{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "expo-web",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "--max-old-space-size=8192",
        "node_modules/expo/bin/cli",
        "start",
        "--web"
      ],
      "port": 8081
    },
    {
      "name": "static-export",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "--yes",
        "serve",
        "dist",
        "-l",
        "8090",
        "--no-clipboard"
      ],
      "port": 8090
    },
    {
      "name": "landing",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "--yes",
        "serve",
        "landing",
        "-l",
        "8099",
        "--no-clipboard"
      ],
      "port": 8099
    },
    {
      "name": "landing-8107",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "--yes",
        "serve",
        "landing",
        "-l",
        "8107",
        "--no-clipboard"
      ],
      "port": 8107
    },
    {
      "name": "static-export-dev",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "--yes",
        "serve",
        "dist-dev",
        "-l",
        "8091",
        "--no-clipboard"
      ],
      "port": 8091
    },
    {
      "name": "expo-web-clear",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "--max-old-space-size=8192",
        "node_modules/expo/bin/cli",
        "start",
        "--web",
        "--clear"
      ],
      "port": 8081
    },
    {
      "name": "expo-web-8082",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "expo",
        "start",
        "--web",
        "--port",
        "8082"
      ],
      "port": 8082
    }
  ]
}