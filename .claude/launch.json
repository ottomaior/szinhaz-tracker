{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "expo-web",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "expo",
        "start",
        "--web"
      ],
      "port": 8081
    },
    {
      "name": "static-export",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "--yes",
        "serve",
        "dist",
        "-l",
        "8090",
        "--no-clipboard"
      ],
      "port": 8090
    },
    {
      "name": "landing",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "--yes",
        "serve",
        "landing",
        "-l",
        "8099",
        "--no-clipboard"
      ],
      "port": 8099
    }
  ]
}
