# Cloudflare Pages reads this file at deploy time.
#
# The screenshots are content-addressed by nothing at all — they are plain
# filenames — so they are cached for a day rather than a year, and the page
# itself is always revalidated. That way a redeploy is visible immediately
# without the images being refetched on every visit.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN

/index.html
  Cache-Control: public, max-age=0, must-revalidate

/shots/*
  Cache-Control: public, max-age=86400

# The icons and the share card change about as often as the logo does, and a
# scraper that has already cached og.png will keep serving its copy anyway —
# so there is nothing to gain from making every visitor revalidate them.
/og.png
  Cache-Control: public, max-age=604800
/icon.svg
  Cache-Control: public, max-age=604800
/favicon.png
  Cache-Control: public, max-age=604800
/apple-touch-icon.png
  Cache-Control: public, max-age=604800
